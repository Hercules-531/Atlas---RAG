PRUNE_API_KEY=
PRUNE_BASE_URL=https://api.withprune.com/v1
ATLAS_CLOUD_MODEL=gemini-3.5-flash-lite
ATLAS_DATA_DIR=data
ATLAS_EMBEDDING_MODEL=google/embeddinggemma-2
ATLAS_LOCAL_MODEL=gemma-4-12B-it-qat
ATLAS_MAX_UPLOAD_MIB=100
ATLAS_MAX_PDF_PAGES=1000
ATLAS_MAX_TABLE_ROWS=250000
ATLAS_MAX_EXTRACTED_TEXT_MIB=50
ATLAS_SEMANTIC_CHUNKING=false
ATLAS_MAX_SOURCE_IMAGES=40
ATLAS_MAX_SOURCE_IMAGE_PIXELS=20000000
ATLAS_MAX_SOURCE_IMAGE_MIB=24
# Optional: complete, already-downloaded multilingual faster-whisper model folder.
ATLAS_SPEECH_MODEL_DIR=
ATLAS_MAX_DICTATION_SECONDS=60
ATLAS_MAX_DICTATION_MIB=8
ATLAS_DICTATION_TIMEOUT_SECONDS=150
